# resturant bill
bill = float(input("Enter your resturant bill: R"))
tip = 0.15 # 15%
val_tip = bill * tip
total_cost = bill + val_tip

print(f"Total Tip for waiter is: R{val_tip}")
print(f"Total tip rounded off is: R{round(val_tip, 2)}")# method to round off a value is round(), to the nearest int is round(var, 2)

print(f"Total cost of today's Bill is: R{total_cost}")
print(f"Total cost rounded off is: R{round(total_cost, 2)}")


